# syntax=docker/dockerfile:1
# GENERATED by `kmwc sync` from @keenmate/web-components-devkit — do not edit.
# Change package.json#kmwc (or the devkit template) and re-run `npx kmwc sync`.
#
# Examples site for web-grid-workspace: Vite multi-page build → static nginx.

# ─────────────────────────────────────────────────────────────────────────────
# Stage 1 — build: `npm run build:examples` (= vite build --mode examples)
# ─────────────────────────────────────────────────────────────────────────────
FROM node:24-alpine AS build
WORKDIR /app

# Latest npm first — the bundled one can lag by weeks; newer npm ships registry
# hardening that reduces supply-chain exposure. Own layer, cached per base image.
RUN npm install -g npm@latest

# NOT `npm ci`: local lockfiles may resolve sibling packages (core, devkit) to
# file: links that don't exist in this build context. A plain install
# re-resolves them from the registry. Manifests first so this layer stays
# cached until dependencies change.
COPY package.json ./
COPY packages/web-grid/package.json packages/web-grid/
RUN npm install --no-audit --no-fund

# Source + build. The kmwc Vite plugin bundles each example page, injects the
# shared kit, stamps the version badge (BUILD_TIME, default: now) and adds the
# analytics snippet — no post-build sed.
COPY . .
ARG BUILD_TIME
ENV BUILD_TIME=${BUILD_TIME}
RUN npm run build:examples

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2 — serve
# ─────────────────────────────────────────────────────────────────────────────
FROM nginx:alpine AS serve
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist-examples /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
