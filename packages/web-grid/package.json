{
	"name": "@keenmate/web-grid",
	"version": "2.0.0-rc01",
	"description": "Framework-agnostic data grid web component with sorting, filtering, inline editing, and keyboard navigation",
	"type": "module",
	"main": "./dist/web-grid.umd.js",
	"module": "./dist/web-grid.js",
	"types": "./dist/index.d.ts",
	"customElements": "custom-elements.json",
	"web-types": "web-types.json",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/web-grid.js",
			"require": "./dist/web-grid.umd.js",
			"default": "./dist/web-grid.js"
		},
		"./css": "./src/css/main.css",
		"./manifest": "./component-variables.manifest.json",
		"./dist/*": "./dist/*",
		"./src/css/*": "./src/css/*",
		"./package.json": "./package.json"
	},
	"sideEffects": [
		"./dist/web-grid.js",
		"./dist/web-grid.umd.js",
		"*.css"
	],
	"files": [
		"dist",
		"src/css",
		"ai",
		"component-variables.manifest.json",
		"release-notes",
		"custom-elements.json",
		"web-types.json",
		"vscode.html-custom-data.json",
		"vscode.css-custom-data.json"
	],
	"scripts": {
		"dev": "vite --port 12500",
		"check:contract": "base-contract-check src",
		"build": "npm run clean:dist && npm run check:contract && npm run analyze && tsc && vite build",
		"build:types": "tsc",
		"preview": "vite preview",
		"clean": "rimraf dist --glob \"*.tgz\"",
		"clean:dist": "rimraf dist",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"analyze": "cem analyze"
	},
	"keywords": [
		"grid",
		"data-grid",
		"table",
		"datagrid",
		"editable",
		"sortable",
		"filterable",
		"pagination",
		"inline-editing",
		"web-component",
		"custom-element",
		"shadow-dom",
		"typescript",
		"dark-mode",
		"context-menu",
		"row-toolbar",
		"keyboard-navigation",
		"keenmate",
		"web-components",
		"custom-elements"
	],
	"author": "Keenmate",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KeenMate/web-grid.git"
	},
	"bugs": {
		"url": "https://github.com/KeenMate/web-grid/issues"
	},
	"homepage": "https://github.com/KeenMate/web-grid#readme",
	"devDependencies": {
		"@custom-elements-manifest/analyzer": "^0.11.0",
		"@keenmate/base-css-variables": "^2.0.1",
		"@vitest/ui": "^4.1.10",
		"custom-element-jet-brains-integration": "^1.8.0",
		"custom-element-vs-code-integration": "^1.5.0",
		"happy-dom": "^20.10.6",
		"rimraf": "^5.0.5",
		"typescript": "^5.3.3",
		"vite": "^8.1.4",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@keenmate/web-components-core": "^1.0.0-rc21"
	}
}
